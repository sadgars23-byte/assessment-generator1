# ==============================================================
# AI Assessment Generator - Environment Configuration
# ==============================================================
# Copy this file to '.env' and fill in your API key:
#
#   copy .env.example .env
#
# Keep this file server-side. Do NOT prefix with VITE_ to protect your keys.

# ==============================================================
# 1. OPTION 1: Google Gemini (Recommended - Free & 1M Context)
# ==============================================================
# Get your free key at: https://aistudio.google.com/app/apikey
AI_API_KEY=your_gemini_api_key_here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-flash-lite-latest

# ==============================================================
# 2. OPTION 2: Groq (Ultra-Fast 500+ tokens/sec, Free Tier)
# ==============================================================
# Get your free Groq API key at: https://console.groq.com/keys
# AI_API_KEY=gsk_your_groq_key_here
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# ==============================================================
# 3. OPTION 3: OpenAI
# ==============================================================
# Get your API key at: https://platform.openai.com/api-keys
# AI_API_KEY=your_openai_api_key_here
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ==============================================================
# 4. OPTION 4: DeepSeek
# ==============================================================
# Get your API key at: https://platform.deepseek.com/api_keys
# AI_API_KEY=sk-...your_deepseek_key
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# ==============================================================
# 5. OPTION 5: OpenRouter (Access to 100+ models)
# ==============================================================
# Get your API key at: https://openrouter.ai/keys
# AI_API_KEY=sk-or-...your_openrouter_key
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openai/gpt-4o-mini

# ==============================================================
# 6. OPTION 6: Ollama (100% Local & Free, No API Key Needed)
# ==============================================================
# Download from https://ollama.ai and run: ollama run llama3.2
# AI_API_KEY=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2
